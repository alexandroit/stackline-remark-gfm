{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-remark-gfm/issues"
  },
  "main": "index.js",
  "name": "@stackline/remark-gfm",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test/index.js",
    "test": "npm run test:upstream && node --test test/stackline-oracle.test.mjs",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://github.com/alexandroit/stackline-remark-gfm#readme",
  "keywords": [
    "unified",
    "remark",
    "remark-plugin",
    "plugin",
    "mdast",
    "markdown",
    "table",
    "strikethrough",
    "tasklist",
    "autolink",
    "footnote",
    "github",
    "gfm",
    "stackline",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-remark-gfm.git"
  },
  "description": "remark plugin to support GFM (autolink literals, footnotes, strikethrough, tables, tasklists)",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    }
  ],
  "dependencies": {
    "unified": "^10.0.0",
    "@types/mdast": "^3.0.0",
    "mdast-util-gfm": "^2.0.0",
    "micromark-extension-gfm": "^2.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "devDependencies": {
    "is-hidden": "^2.0.0",
    "remark": "^14.0.0",
    "string-width": "^5.0.0",
    "tape": "5.10.2",
    "to-vfile": "^7.0.0",
    "typescript": "7.0.2",
    "@types/node": "24.12.2",
    "upstream-oracle": "npm:remark-gfm@3.0.1"
  },
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
}
